              "type": "integer"
            },
            {
              "type": "string"
            }
          ],
          "x-kubernetes-int-or-string": true
        }
      }
    },
    "host": {
      "description": "Hostname for the Airflow UI on the ComputePlane's ingress. Leave empty to keep it reachable only inside the cluster.",
      "type": "string",
      "default": ""
    },
    "logs": {
      "description": "Task log retention.",
      "type": "object",
      "default": {},
      "required": [
        "persistence",
        "size"
      ],
      "properties": {
        "persistence": {
          "description": "Keep task logs on a shared volume.",
          "type": "boolean",
          "default": true
        },
        "size": {
          "description": "Volume size for logs.",
          "default": "20Gi",
          "pattern": "^(\\+|-)?(([0-9]+(\\.[0-9]*)?)|(\\.[0-9]+))(([KMGTPE]i)|[numkMGTPE]|([eE](\\+|-)?(([0-9]+(\\.[0-9]*)?)|(\\.[0-9]+))))?$",
