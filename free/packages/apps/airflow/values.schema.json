    "dags": {
      "description": "DAG source.",
      "type": "object",
      "default": {},
      "required": [
        "branch",
        "syncPeriod"
      ],
      "properties": {
        "branch": {
          "description": "Branch to track.",
          "type": "string",
          "default": "main"
        },
        "repo": {
          "description": "Git repository to sync DAGs from. Leave empty to configure DAG delivery yourself.",
          "type": "string",
          "default": ""
        },
        "sshSecret": {
          "description": "Name of a Secret holding an SSH key for a private repository. It must already exist on the ComputePlane.",
          "type": "string",
          "default": ""
        },
        "subPath": {
          "description": "Path within the repository holding the DAG files. Empty means the repository root.",
          "type": "string",
          "default": ""
        },
        "syncPeriod": {
          "description": "How often to poll the repository for changes.",
          "type": "string",
          "default": "60s"
        }
      }
    },
    "database": {
      "description": "Metadata database.",
      "type": "object",
      "default": {},
      "required": [
        "replicas",
        "size"
      ],
      "properties": {
        "password": {
          "description": "Explicit password. When empty, one is generated and preserved across reconciles.",
          "type": "string",
          "default": ""
        },
        "replicas": {
          "description": "Number of database instances.",
          "type": "integer",
          "default": 2
        },
        "size": {
          "description": "Persistent Volume size.",
          "default": "10Gi",
          "pattern": "^(\\+|-)?(([0-9]+(\\.[0-9]*)?)|(\\.[0-9]+))(([KMGTPE]i)|[numkMGTPE]|([eE](\\+|-)?(([0-9]+(\\.[0-9]*)?)|(\\.[0-9]+))))?$",
