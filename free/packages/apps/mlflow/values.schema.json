{
  "title": "Chart Values",
  "type": "object",
  "properties": {
    "database": {
      "description": "PostgreSQL configuration.",
      "type": "object",
      "default": {},
      "required": [
        "replicas",
        "size"
      ],
      "properties": {
        "password": {
          "description": "Optional explicit password. When empty, one is generated and preserved across reconciles.",
          "type": "string",
          "default": ""
        },
        "replicas": {
          "description": "Number of database instances.",
          "type": "integer",
          "default": 2
        },
        "size": {
          "description": "Persistent Volume size for metadata.",
          "default": "10Gi",
          "pattern": "^(\\+|-)?(([0-9]+(\\.[0-9]*)?)|(\\.[0-9]+))(([KMGTPE]i)|[numkMGTPE]|([eE](\\+|-)?(([0-9]+(\\.[0-9]*)?)|(\\.[0-9]+))))?$",
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ],
          "x-kubernetes-int-or-string": true
        }
      }
    },
    "host": {
      "description": "Hostname for external access to the MLflow UI and tracking API via Ingress. Leave empty to keep it reachable only inside the cluster.",
      "type": "string",
      "default": ""
    },
    "lakehouseRef": {
      "description": "Name of the `Lakehouse` in this namespace whose bucket holds the run artifacts — models, plots, whatever a training run writes. Metadata lives in the private Postgres below; artifacts are large and belong in object storage.",
      "type": "string",
      "default": ""
    },
    "replicaCount": {
      "description": "Number of tracking-server replicas. Stateless — all state is in Postgres and the bucket — so this scales freely.",
      "type": "integer",
      "default": 2
    },
    "resources": {
      "description": "Explicit resources, overriding the preset.",
      "type": "object",
      "default": {},
      "properties": {
        "cpu": {
          "description": "CPU available to the server.",
          "pattern": "^(\\+|-)?(([0-9]+(\\.[0-9]*)?)|(\\.[0-9]+))(([KMGTPE]i)|[numkMGTPE]|([eE](\\+|-)?(([0-9]+(\\.[0-9]*)?)|(\\.[0-9]+))))?$",
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ],
          "x-kubernetes-int-or-string": true
        },
        "memory": {
          "description": "Memory available to the server.",
          "pattern": "^(\\+|-)?(([0-9]+(\\.[0-9]*)?)|(\\.[0-9]+))(([KMGTPE]i)|[numkMGTPE]|([eE](\\+|-)?(([0-9]+(\\.[0-9]*)?)|(\\.[0-9]+))))?$",
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ],
          "x-kubernetes-int-or-string": true
        }
      }
    },
    "resourcesPreset": {
      "description": "Default sizing preset. The tracking server records runs rather than executing them, so it stays small no matter how large the training jobs writing to it are.",
      "type": "string",
      "default": "t1.medium",
      "enum": [
        "t1.nano",
        "t1.micro",
        "t1.small",
        "t1.medium",
        "t1.large",
        "t1.xlarge",
        "t1.2xlarge",
        "t1.4xlarge",
        "c1.nano",
        "c1.micro",
        "c1.small",
        "c1.medium",
        "c1.large",
        "c1.xlarge",
        "c1.2xlarge",
        "c1.4xlarge",
        "s1.nano",
        "s1.micro",
        "s1.small",
        "s1.medium",
        "s1.large",
        "s1.xlarge",
        "s1.2xlarge",
        "s1.4xlarge",
        "u1.nano",
        "u1.micro",
        "u1.small",
        "u1.medium",
        "u1.large",
        "u1.xlarge",
        "u1.2xlarge",
        "u1.4xlarge",
        "m1.nano",
        "m1.micro",
        "m1.small",
        "m1.medium",
        "m1.large",
        "m1.xlarge",
        "m1.2xlarge",
        "m1.4xlarge"
      ]
    },
    "storageClass": {
      "description": "StorageClass for the managed Postgres PVCs. Leave empty to use the cluster default.",
      "type": "string",
      "default": ""
    }
  }
}