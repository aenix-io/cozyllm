{
  "title": "Chart Values",
  "type": "object",
  "properties": {
    "database": {
      "description": "Coder database.",
      "type": "object",
      "default": {},
      "required": [
        "replicas",
        "size"
      ],
      "properties": {
        "password": {
          "description": "Explicit password. When empty, one is generated and preserved across reconciles.",
          "type": "string",
          "default": ""
        },
        "replicas": {
          "description": "Number of database instances.",
          "type": "integer",
          "default": 2
        },
        "size": {
          "description": "Persistent Volume size.",
          "default": "10Gi",
          "pattern": "^(\\+|-)?(([0-9]+(\\.[0-9]*)?)|(\\.[0-9]+))(([KMGTPE]i)|[numkMGTPE]|([eE](\\+|-)?(([0-9]+(\\.[0-9]*)?)|(\\.[0-9]+))))?$",
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ],
          "x-kubernetes-int-or-string": true
        }
      }
    },
    "host": {
      "description": "Hostname the Coder UI is reached by. Required: Coder builds the URLs it hands to browsers and workspace agents from this, so it cannot be derived from a Service address.",
      "type": "string",
      "default": ""
    },
    "replicaCount": {
      "description": "Number of Coder server replicas.",
      "type": "integer",
      "default": 2
    },
    "resources": {
      "description": "Explicit resources, overriding the preset.",
      "type": "object",
      "default": {},
      "properties": {
        "cpu": {
          "description": "CPU available to the pod.",
          "pattern": "^(\\+|-)?(([0-9]+(\\.[0-9]*)?)|(\\.[0-9]+))(([KMGTPE]i)|[numkMGTPE]|([eE](\\+|-)?(([0-9]+(\\.[0-9]*)?)|(\\.[0-9]+))))?$",
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ],
          "x-kubernetes-int-or-string": true
        },
        "memory": {
          "description": "Memory available to the pod.",
          "pattern": "^(\\+|-)?(([0-9]+(\\.[0-9]*)?)|(\\.[0-9]+))(([KMGTPE]i)|[numkMGTPE]|([eE](\\+|-)?(([0-9]+(\\.[0-9]*)?)|(\\.[0-9]+))))?$",
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ],
          "x-kubernetes-int-or-string": true
        }
      }
    },
    "resourcesPreset": {
      "description": "Sizing preset for the Coder server. The server brokers connections and provisions workspaces rather than running their workloads, so it stays small however large the workspaces are.",
      "type": "string",
      "default": "t1.medium",
      "enum": [
        "t1.nano",
        "t1.micro",
        "t1.small",
        "t1.medium",
        "t1.large",
        "t1.xlarge",
        "t1.2xlarge",
        "t1.4xlarge",
        "c1.nano",
        "c1.micro",
        "c1.small",
        "c1.medium",
        "c1.large",
        "c1.xlarge",
        "c1.2xlarge",
        "c1.4xlarge",
        "s1.nano",
        "s1.micro",
        "s1.small",
        "s1.medium",
        "s1.large",
        "s1.xlarge",
        "s1.2xlarge",
        "s1.4xlarge",
        "u1.nano",
        "u1.micro",
        "u1.small",
        "u1.medium",
        "u1.large",
        "u1.xlarge",
        "u1.2xlarge",
        "u1.4xlarge",
        "m1.nano",
        "m1.micro",
        "m1.small",
        "m1.medium",
        "m1.large",
        "m1.xlarge",
        "m1.2xlarge",
        "m1.4xlarge"
      ]
    },
    "storageClass": {
      "description": "StorageClass for the database on the management cluster. Leave empty to use the cluster default.",
      "type": "string",
      "default": ""
    },
    "wildcardHost": {
      "description": "Base domain for per-workspace application subdomains, without the leading wildcard. Leave empty to serve workspace apps on paths instead, which breaks any app that assumes it owns the document root.",
      "type": "string",
      "default": ""
    }
  }
}