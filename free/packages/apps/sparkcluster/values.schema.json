{
  "title": "Chart Values",
  "type": "object",
  "properties": {
    "controller": {
      "description": "Spark Operator deployment.",
      "type": "object",
      "default": {},
      "required": [
        "replicas",
        "resourcesPreset"
      ],
      "properties": {
        "replicas": {
          "description": "Number of operator replicas.",
          "type": "integer",
          "default": 1
        },
        "resources": {
          "description": "Explicit resources, overriding the preset.",
          "type": "object",
          "default": {},
          "properties": {
            "cpu": {
              "description": "CPU available to the pod.",
              "pattern": "^(\\+|-)?(([0-9]+(\\.[0-9]*)?)|(\\.[0-9]+))(([KMGTPE]i)|[numkMGTPE]|([eE](\\+|-)?(([0-9]+(\\.[0-9]*)?)|(\\.[0-9]+))))?$",
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "string"
                }
              ],
              "x-kubernetes-int-or-string": true
            },
            "memory": {
              "description": "Memory available to the pod.",
              "pattern": "^(\\+|-)?(([0-9]+(\\.[0-9]*)?)|(\\.[0-9]+))(([KMGTPE]i)|[numkMGTPE]|([eE](\\+|-)?(([0-9]+(\\.[0-9]*)?)|(\\.[0-9]+))))?$",
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "string"
                }
              ],
              "x-kubernetes-int-or-string": true
            }
          }
        },
        "resourcesPreset": {
          "description": "Sizing preset for the operator.",
          "type": "string",
          "default": "t1.medium",
          "enum": [
            "t1.nano",
            "t1.micro",
            "t1.small",
            "t1.medium",
            "t1.large",
            "t1.xlarge",
            "t1.2xlarge",
            "t1.4xlarge",
            "c1.nano",
            "c1.micro",
            "c1.small",
            "c1.medium",
            "c1.large",
            "c1.xlarge",
            "c1.2xlarge",
            "c1.4xlarge",
            "s1.nano",
            "s1.micro",
            "s1.small",
            "s1.medium",
            "s1.large",
            "s1.xlarge",
            "s1.2xlarge",
            "s1.4xlarge",
            "u1.nano",
            "u1.micro",
            "u1.small",
            "u1.medium",
            "u1.large",
            "u1.xlarge",
            "u1.2xlarge",
            "u1.4xlarge",
            "m1.nano",
            "m1.micro",
            "m1.small",
            "m1.medium",
            "m1.large",
            "m1.xlarge",
            "m1.2xlarge",
            "m1.4xlarge"
          ]
        }
      }
    },
    "lakehouseRef": {
      "description": "Name of the `Lakehouse` in this namespace whose tables jobs read and write. Required: a compute engine with no warehouse to point at has nothing to do.",
      "type": "string",
      "default": ""
    }
  }
}